{
  "name": "divine-orchestration",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file=playwright.env ./node_modules/@playwright/test/cli.js test",
    "check": "npm run build && npm test && npm run test:e2e",
    "test:e2e:install": "node --env-file=playwright.env ./node_modules/@playwright/test/cli.js install chromium firefox webkit"
  },
  "dependencies": {
    "@astrodraw/astrochart": "3.0.2",
    "@astrologer/ephemera": "0.4.1",
    "@js-temporal/polyfill": "0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
