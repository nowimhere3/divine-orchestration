{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:divine-orchestration:personalized-research:v2",
  "title": "Divine Orchestration personalized research manifest and evidence parts",
  "oneOf": [{"$ref":"#/$defs/manifest"},{"$ref":"#/$defs/part"}],
  "$defs": {
    "count": {"type":"integer","minimum":0},
    "ordinal": {"type":"integer","minimum":1},
    "score": {"type":"integer","minimum":0,"maximum":100},
    "eventId": {"type":"string","pattern":"^event-[1-9]\\d*$"},
    "moment": {"$ref":"urn:divine-orchestration:research-export:v1#/$defs/moment"},
    "scope": {"enum":["current","relevant","complete"]},
    "manifest": {
      "type":"object",
      "additionalProperties":false,
      "required":["schema","schemaVersion","packageId","format","research","partByteBudget","parts"],
      "properties":{
        "schema":{"const":"divine-orchestration/research-manifest"},
        "schemaVersion":{"const":2},
        "packageId":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/packageId"},
        "format":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/format"},
        "research":{"$ref":"#/$defs/research"},
        "partByteBudget":{"$ref":"urn:divine-orchestration:research-manifest:v1#/properties/partByteBudget"},
        "parts":{"$ref":"urn:divine-orchestration:research-manifest:v1#/properties/parts","minItems":1}
      }
    },
    "part": {
      "type":"object",
      "additionalProperties":false,
      "required":["schema","schemaVersion","packageId","format","privacy","partNumber","totalParts","eventCount","totalEvents","eventIndexRange","instruction","events"],
      "properties":{
        "schema":{"const":"divine-orchestration/research-events-part"},
        "schemaVersion":{"const":2},
        "packageId":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/packageId"},
        "format":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/format"},
        "privacy":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/privacy"},
        "partNumber":{"$ref":"#/$defs/ordinal"},
        "totalParts":{"$ref":"#/$defs/ordinal"},
        "eventCount":{"$ref":"#/$defs/count"},
        "totalEvents":{"$ref":"#/$defs/count"},
        "eventIndexRange":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/eventIndexRange"},
        "instruction":{"type":"string"},
        "events":{"type":"array","items":{"$ref":"#/$defs/event"}}
      }
    },
    "research": {
      "type":"object",
      "additionalProperties":false,
      "required":["exportMode","privacy","privacyNotices","query","themes","scope","calculation","snapshot","chartFactors","natalSynthesis","selectedMomentTransit","ai","personalized"],
      "properties":{
        "exportMode":{"enum":["focused","complete"]},
        "privacy":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/privacy"},
        "privacyNotices":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/research/properties/privacyNotices"},
        "query":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/query"},
        "themes":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/themes"},
        "scope":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/scope"},
        "calculation":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/calculation"},
        "snapshot":{"$ref":"urn:divine-orchestration:snapshot:v0"},
        "chartFactors":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/chartFactors"},
        "natalSynthesis":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/research/properties/natalSynthesis"},
        "selectedMomentTransit":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/research/properties/selectedMomentTransit"},
        "ai":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/research/properties/ai"},
        "personalized":{"$ref":"#/$defs/personalized"}
      }
    },
    "event": {
      "type":"object",
      "additionalProperties":false,
      "required":["id","orderAt","facts","axisCompanions","relevance","cycleId","personalImpact","selection"],
      "properties":{
        "id":{"$ref":"#/$defs/eventId"},
        "orderAt":{"$ref":"#/$defs/moment"},
        "facts":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/facts"},
        "axisCompanions":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/event/properties/axisCompanions"},
        "relevance":{"$ref":"urn:divine-orchestration:research-export:v1#/$defs/relevance"},
        "cycleId":{"type":"string","pattern":"^cycle-[1-9]\\d*$"},
        "personalImpact":{"$ref":"#/$defs/impact"},
        "selection":{
          "type":"object","additionalProperties":false,
          "required":["role","displayRank","representativeId"],
          "properties":{
            "role":{"enum":["primary","linked","scope"]},
            "displayRank":{"anyOf":[{"$ref":"#/$defs/ordinal"},{"type":"null"}]},
            "representativeId":{"anyOf":[{"$ref":"#/$defs/eventId"},{"type":"null"}]}
          }
        }
      }
    },
    "impact": {
      "type":"object","additionalProperties":false,
      "required":["modelVersion","total","possibleUpperBound","band","components","missingData","natalPlanetEvidence","evidence"],
      "properties":{
        "modelVersion":{"const":"impact-v1"},
        "total":{"$ref":"#/$defs/score"},
        "possibleUpperBound":{"$ref":"#/$defs/score"},
        "band":{"enum":["background","notable","high"]},
        "components":{
          "type":"object","additionalProperties":false,
          "required":["natalConnection","planetaryCycle","precision","contactType"],
          "properties":{
            "natalConnection":{"$ref":"#/$defs/component"},
            "planetaryCycle":{"$ref":"#/$defs/component"},
            "precision":{"$ref":"#/$defs/component"},
            "contactType":{"$ref":"#/$defs/component"}
          }
        },
        "missingData":{"$ref":"#/$defs/missing"},
        "natalPlanetEvidence":{"type":["object","null"]},
        "evidence":{
          "type":"object","additionalProperties":false,"required":["bestPass","windows"],
          "properties":{
            "bestPass":{"anyOf":[{"type":"null"},{
              "type":"object","additionalProperties":false,"required":["eventId","passIndex"],
              "properties":{"eventId":{"$ref":"#/$defs/eventId"},"passIndex":{"$ref":"#/$defs/ordinal"}}
            }]},
            "windows":{"type":"array","items":{
              "type":"object","additionalProperties":false,
              "required":["eventId","seriesId","observedDays","durationIsMinimum","exactPassCountInWindow","exactPassCountInSeries","seriesComplete"],
              "properties":{
                "eventId":{"$ref":"#/$defs/eventId"},"seriesId":{"type":"string","pattern":"^series-[1-9]\\d*$"},
                "observedDays":{"type":["number","null"],"minimum":0},"durationIsMinimum":{"type":"boolean"},
                "exactPassCountInWindow":{"$ref":"#/$defs/count"},"exactPassCountInSeries":{"$ref":"#/$defs/count"},"seriesComplete":{"type":"boolean"}
              }
            }}
          }
        }
      }
    },
    "missing":{
      "type":"array",
      "items":{"enum":["natal-planet-factor-unavailable","natal-house-placement-unavailable","traditional-angular-rulership-unavailable","traditional-chart-ruler-unavailable","station-natal-house-unavailable","closest-approach-unobserved","closest-approach-may-be-clipped","point-time-unavailable"]}
    },
    "component":{
      "type":"object","additionalProperties":false,"required":["points","possiblePoints","reason","missing"],
      "properties":{
        "points":{"type":"number","minimum":0,"maximum":40},"possiblePoints":{"type":"number","minimum":0,"maximum":40},
        "reason":{"type":"string"},"missing":{"$ref":"#/$defs/missing"}
      }
    },
    "personalized":{
      "type":"object","additionalProperties":false,"required":["modelVersion","convention","selection","overview"],
      "properties":{
        "modelVersion":{"const":"impact-v1"},
        "convention":{"type":"string"},
        "selection":{
          "type":"object","additionalProperties":false,
          "required":["scope","filters","linkedEvidenceIncluded","counts","currentExclusions"],
          "properties":{
            "scope":{"$ref":"#/$defs/scope"},
            "filters":{
              "type":"object","additionalProperties":false,
              "required":["scope","category","sort","minimumImpact","top","showMoon","multiThemeOnly","matchTheme"],
              "properties":{
                "scope":{"enum":["all","primary","relevant","context"]},"category":{"enum":["exact","station","all"]},
                "sort":{"enum":["chronological","relevance","impact","priority"]},"minimumImpact":{"anyOf":[{"$ref":"#/$defs/score"},{"type":"null"}]},
                "top":{"enum":[null,10,20,50]},"showMoon":{"type":"boolean"},"multiThemeOnly":{"type":"boolean"},"matchTheme":{"type":"boolean"}
              }
            },
            "linkedEvidenceIncluded":{"type":"boolean"},
            "counts":{
              "type":"object","required":["current","linked","relevant","complete","exported","excludedFromComplete","distinctCycles","primary","linkedIncluded"],
              "additionalProperties":{"$ref":"#/$defs/count"},"minProperties":9,"maxProperties":9
            },
            "currentExclusions":{"anyOf":[{"type":"null"},{
              "type":"object","required":["outsideViewScope","displayFilters","impactCutoff","topLimit","linkedEvidence"],
              "additionalProperties":{"$ref":"#/$defs/count"},"minProperties":5,"maxProperties":5
            }]}
          }
        },
        "overview":{
          "type":"object","additionalProperties":false,"required":["strongest","strongestLimit","limitedImpactEvidence","overlaps"],
          "properties":{
            "strongestLimit":{"const":5},"limitedImpactEvidence":{"$ref":"#/$defs/count"},
            "strongest":{"type":"array","maxItems":5,"items":{
              "type":"object","additionalProperties":false,"required":["eventId","label","personalImpact","themeRelevance"],
              "properties":{"eventId":{"$ref":"#/$defs/eventId"},"label":{"type":"string"},"personalImpact":{"$ref":"#/$defs/score"},"themeRelevance":{"$ref":"#/$defs/score"}}
            }},
            "overlaps":{
              "type":"object","additionalProperties":false,
              "required":["minimumImpact","includeMoonMarkers","totalPeriods","omittedWindows","highlightLimit","eventRefsPerHighlight","markerRefsPerHighlight","highlights"],
              "properties":{
                "minimumImpact":{"type":"number","minimum":0,"maximum":100},"includeMoonMarkers":{"type":"boolean"},
                "totalPeriods":{"$ref":"#/$defs/count"},"omittedWindows":{"$ref":"#/$defs/count"},
                "highlightLimit":{"const":3},"eventRefsPerHighlight":{"const":12},"markerRefsPerHighlight":{"const":3},
                "highlights":{"type":"array","maxItems":3,"items":{"$ref":"#/$defs/overlap"}}
              }
            }
          }
        }
      }
    },
    "bodies":{"type":"array","minItems":2,"maxItems":9,"uniqueItems":true,"items":{"enum":["sun","mercury","venus","mars","jupiter","saturn","uranus","neptune","pluto"]}},
    "overlap":{
      "type":"object","additionalProperties":false,
      "required":["periodNumber","start","end","observedDays","clippedStart","clippedEnd","complete","bodies","peakConcurrentBodies","peak","contactCount","eventIds","markerCount","markers"],
      "properties":{
        "periodNumber":{"$ref":"#/$defs/ordinal"},"start":{"$ref":"#/$defs/moment"},"end":{"$ref":"#/$defs/moment"},
        "observedDays":{"type":"number","exclusiveMinimum":0},"clippedStart":{"type":"boolean"},"clippedEnd":{"type":"boolean"},"complete":{"type":"boolean"},
        "bodies":{"$ref":"#/$defs/bodies"},"peakConcurrentBodies":{"type":"integer","minimum":2,"maximum":9},
        "peak":{
          "type":"object","additionalProperties":false,"required":["start","end","bodies"],
          "properties":{"start":{"$ref":"#/$defs/moment"},"end":{"$ref":"#/$defs/moment"},"bodies":{"$ref":"#/$defs/bodies"}}
        },
        "contactCount":{"$ref":"#/$defs/count"},"eventIds":{"type":"array","uniqueItems":true,"maxItems":12,"items":{"$ref":"#/$defs/eventId"}},
        "markerCount":{"$ref":"#/$defs/count"},"markers":{"type":"array","maxItems":3,"items":{
          "type":"object","additionalProperties":false,"required":["eventId","at","kind"],
          "properties":{"eventId":{"$ref":"#/$defs/eventId"},"at":{"$ref":"#/$defs/moment"},"kind":{"enum":["exact-pass","station","house-ingress"]}}
        }}
      }
    }
  }
}
